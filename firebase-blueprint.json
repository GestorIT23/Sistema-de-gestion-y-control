        "identificacionCaldera": { "type": "string" },
        "operadorResponsable": { "type": "string" },
        "fecha": { "type": "string" },
        "turnoSeleccionado": { "type": "string" },
        "turno1": { "type": "object" },
        "turno2": { "type": "object" },
        "checklist": { "type": "object" },
        "eventos": { "type": "array" }
      },
      "required": ["identificacionCaldera", "operadorResponsable", "fecha"]
    }
