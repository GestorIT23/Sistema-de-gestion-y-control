      "properties": {
        "folio": { "type": "string" },
        "equipoId": { "type": "string" },
        "nombreEquipo": { "type": "string" },
        "fecha": { "type": "string" },
        "turno": { "type": "string" },
        "horometroActual": { "type": "number" },
        "puntajeGlobal": { "type": "number" },
        "veredictoOperacional": { "type": "string" },
        "nivelRiesgo": { "type": "string" },
        "operadorAsignado": { "type": "string" },
        "inspectorSgi": { "type": "string" }
      },
      "required": ["folio", "equipoId", "nombreEquipo", "fecha", "puntajeGlobal"]
    },
    "BitacoraControlCaldera": {
